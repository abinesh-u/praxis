APP_ENV=development
PRAXIS_ENV=development
APP_NAME=Praxis
API_HOST=0.0.0.0
API_PORT=8000
# The current API vertical slice uses SQLite. A PostgreSQL adapter remains a later step.
DATABASE_URL=sqlite:///./.praxis/praxis.db
PRAXIS_SKILLS_DIR=./.praxis/skills
REDIS_URL=redis://localhost:6379/0
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PRAXIS_API_URL=http://localhost:8000
# Configure opaque owner=token pairs on the API and pass the matching token to the CLI.
PRAXIS_AUTH_TOKENS=default=replace-with-a-long-random-token
PRAXIS_API_TOKEN=replace-with-a-long-random-token
# Optional bounded external execution provider. It must accept Idempotency-Key
# and return JSON with operation_id and status=completed.
PRAXIS_WEBHOOK_URL=
# Optional bearer credential for the configured provider. Never commit a real value.
PRAXIS_WEBHOOK_AUTH_TOKEN=
# Optional separate credential when the read-only status endpoint has a
# different origin. Never reuse a dispatch credential across origins.
PRAXIS_WEBHOOK_STATUS_AUTH_TOKEN=
# Optional read-only provider operation lookup base URL.
PRAXIS_WEBHOOK_STATUS_URL=
# Recommended in deployments: comma-separated exact provider hostnames.
PRAXIS_WEBHOOK_ALLOWED_HOSTS=
# M1 local provider only; never enable this in staging/production.
PRAXIS_WEBHOOK_ALLOW_PRIVATE_DESTINATIONS=
MODEL_PROVIDER=nebius
MODEL_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
